{
  "name": "dio-odi-mcp",
  "version": "0.1.2",
  "private": false,
  "type": "module",
  "description": "Read-only MCP server exposing the DIO/ODI Reference Model and derived Agentic ER guardrail mappings.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "check": "npm run typecheck && npm test",
    "test:remote": "node tests/remote-smoke.mjs",
    "test:remote:legacy": "node tests/legacy-remote-smoke.mjs",
    "test:remote:all": "npm run test:remote && npm run test:remote:legacy"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "0.33.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261110.1",
    "typescript": "6.0.2",
    "wrangler": "4.160.0"
  }
}
